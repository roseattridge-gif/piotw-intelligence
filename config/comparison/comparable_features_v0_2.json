  "features": [
    {
      "feature_id": "estate_net_change_pct",
      "operational_meaning": "Net change in a consistently scoped physical-location estate over one annual reporting period.",
      "source_family": "estate_footprint_capacity",
      "unit": "percent",
      "denominator": "starting_site_count",
      "comparison_role": "PEER_COMPARABLE",
      "minimum_history_observations": 3,
      "minimum_peer_count": 4,
      "robust_percentile_minimum_peer_count": 10,
      "allowed_normalisation": "100 * (ending_site_count - starting_site_count) / starting_site_count",
      "directionality": "CONTEXTUAL_NOT_HEALTH",
      "condition_types": ["estate_reshaping", "estate_contraction", "estate_expansion"],
      "allowed_anomaly_language": ["above prior observed range", "below prior observed range", "above peers", "below peers", "around peers"],
      "known_caveats": ["Location definitions and portfolio scope must be consistent."]
    },
    {
