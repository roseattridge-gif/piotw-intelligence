                "submissionMethodDetails": "Send tender responses to parish.clerk@layerdelahayeparishcouncil.gov.uk arrange alternative transmission if files are too large by contacting the same email address.",
                "submissionTerms": {
                    "electronicSubmissionPolicy": "notAllowed"
                },
                "tenderPeriod": {
                    "endDate": "2026-08-30T23:59:59+01:00"
                },
                "otherRequirements": {
                    "reservedParticipationLocation": {
                        "gazetteer": {
