                "lots": [
                    {
                        "id": "1",
                        "status": "active",
                        "value": {
                            "amountGross": 192000,
                            "amount": 160000,
                            "currency": "GBP"
                        },
                        "contractPeriod": {
                            "startDate": "2026-10-01T00:00:00+01:00",
                            "endDate": "2027-09-30T23:59:59+01:00"
                        },
                        "awardCriteria": {
                            "description": "Layer de la Haye Parish Council is looking for responses that cover the full scope, including a proposed design and flow for how new and existing equipment will fit together, providing flow for individual age groups, as well as separation for different age groups (toddlers to adult). \nThe most advantageous proposal for the community will be chosen based on several factors:\n- Variety of equipment for the various age ranges to promote and inspire learning, fitness and play\n- Structural strength and sustainability to support different age groups and abilities\n- Signage (re CCTV cover, standard usage warnings etc.) and UK playground standards\n- Playground surfacing compliance\n- Independent inspections\n- Design/layout proposed\n- Design that best enhances wellbeing, safety and accessibility\n- Lead time to supply and install\n- Membership of key trade bodies and safety organisations\n- Examples of previous installs\n- Price is a factor but not the deciding factor"
                        }
                    }
                ],
